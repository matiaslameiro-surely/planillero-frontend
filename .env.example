# Copiá este archivo a .env y ajustá los valores. El .env no se versiona.
#
# Estas variables van al bundle de la aplicación: cualquiera con el APK puede leerlas.
# NUNCA pongas secretos acá.

# URL base del backend, sin barra final.
# En emulador de Android, localhost es el propio emulador: usá 10.0.2.2 para llegar
# a la máquina que lo hospeda. En un dispositivo físico, la IP de tu computadora en la red.
EXPO_PUBLIC_API_URL=http://localhost:8080
